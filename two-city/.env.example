# Optional: sync between devices. Both values are safe to expose in the browser
# (the publishable key can only call the two functions in supabase/migrations).
# On Vercel, add them as Environment Variables with these exact names.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Optional, for the terminal command only (cli/switch.mjs reads these from the
# shell environment, not from this file): the same project URL and publishable
# key, plus the sync code shown in Settings > Backup and devices > Copy code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=sb_publishable_xxx
# TWO_CITY_SYNC_CODE=xxxxxx-xxxxxx-xxxxxx-xxxxxx
