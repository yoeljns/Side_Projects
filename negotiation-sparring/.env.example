# Optional: the AI counterpart. Server-side only: set it in Vercel as an Environment
# Variable (no VITE_ prefix, so it never reaches the browser). Without it the scripted
# counterpart plays.
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: sync between devices. Both values are safe to expose in the browser
# (the publishable key can only call the two functions in supabase/migrations).
# On Vercel, add them as Environment Variables with these exact names.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx
